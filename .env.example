# Copy this file to .env and fill in your values.

# Base URL of your Home Assistant instance
HA_URL=http://homeassistant.local:8123

# Long-lived access token. Generate one at:
# HA Profile -> Security -> Long-Lived Access Tokens -> Create Token
HA_TOKEN=your_long_lived_access_token_here

# --- Feature gating (read-only-first fork) ---

# When true (default), register NO write/destructive tools (no state writes,
# service calls, dashboard edits, automation triggers, notifications).
# Set to false to expose the Core write tools.
HA_READONLY=true

# Expose the HA Core restart tools (restart_core, restart_ha). Requires
# HA_READONLY=false. Default false.
HA_ENABLE_RESTART=false

# Register Supervisor / Hass.io tools: the /api/hassio/* API surface (add-ons,
# OS/supervisor/core/host info, updates, backups, supervisor/core/host/multicast
# logs). HA only exposes /api/hassio/* on HA OS / Supervised installs, NOT on a
# Container (plain Docker) install. Controlled by HA_DEPLOYMENT, overridable.
HA_ENABLE_HASSIO=false

# Deployment type. "container" (default) disables the /api/hassio/* tools;
# "supervised" / "haos" enables them. An explicit HA_ENABLE_HASSIO overrides this
# (HA_ENABLE_SUPERVISOR is accepted as a legacy alias).
HA_DEPLOYMENT=container
